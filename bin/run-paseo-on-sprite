#!/usr/bin/env bash

# Run Paseo under Sprite service management, keep an explicit Sprite task while
# an agent turn is active, and stop this service after Paseo has been idle.
# An external wake mechanism must start the "paseo" service again.

set -u

readonly NODE_BIN="${PASEO_NODE_BIN:-$(command -v node || true)}"
readonly PASEO_CLI="${PASEO_CLI_BIN:-$(readlink -f "$(command -v paseo 2>/dev/null)" 2>/dev/null || true)}"
readonly SPRITE_SOCKET="/.sprite/api.sock"
readonly TASK_NAME="paseo-active-agents"
readonly TASK_URL="http://sprite/v1/tasks/${TASK_NAME}"
readonly SERVICE_STOP_URL="http://sprite/v1/services/paseo/stop"
readonly TASK_BODY='{"expire":"2m"}'
readonly STARTUP_GRACE_SECONDS="${PASEO_STARTUP_GRACE_SECONDS:-600}"
readonly IDLE_GRACE_SECONDS="${PASEO_IDLE_GRACE_SECONDS:-300}"
readonly POLL_SECONDS="${PASEO_POLL_SECONDS:-15}"

daemon_pid=""
task_present=false

put_task() {
  curl \
    --silent \
    --show-error \
    --fail \
    --unix-socket "${SPRITE_SOCKET}" \
    --request PUT \
    --header "Content-Type: application/json" \
    --data "${TASK_BODY}" \
    "${TASK_URL}" >/dev/null
}

delete_task() {
  curl \
    --silent \
    --unix-socket "${SPRITE_SOCKET}" \
    --request DELETE \
    "${TASK_URL}" >/dev/null 2>&1 || true
  task_present=false
}

stop_daemon() {
  if [[ -n "${daemon_pid}" ]]; then
    kill -TERM "${daemon_pid}" 2>/dev/null || true
    wait "${daemon_pid}" 2>/dev/null || true
  fi
}

cleanup() {
  local status=$?

  trap - EXIT INT TERM HUP
  delete_task
  stop_daemon
  exit "${status}"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 0' TERM
trap 'exit 129' HUP

if [[ ! -x "${NODE_BIN}" ]]; then
  echo "Node executable not found at ${NODE_BIN}" >&2
  exit 127
fi

if [[ ! -f "${PASEO_CLI}" ]]; then
  echo "Paseo CLI not found at ${PASEO_CLI}" >&2
  exit 127
fi

"${NODE_BIN}" "${PASEO_CLI}" start \
  --foreground \
  --listen 127.0.0.1:6767 \
  --no-web-ui &
daemon_pid=$!

started_at=$(date +%s)
idle_since="${started_at}"
saw_active=false

while kill -0 "${daemon_pid}" 2>/dev/null; do
  agents_json=$(
    "${NODE_BIN}" "${PASEO_CLI}" ls --json 2>/dev/null
  ) || {
    sleep "${POLL_SECONDS}"
    continue
  }

  active_count=$(
    jq \
      '[.[] | select(.status != "idle" and .status != "archived" and .status != "error" and .status != "failed" and .status != "stopped")] | length' \
      <<<"${agents_json}"
  )
  now=$(date +%s)

  if (( active_count > 0 )); then
    saw_active=true
    idle_since="${now}"
    if put_task; then
      task_present=true
    else
      echo "Warning: could not refresh Sprite active-agent task" >&2
    fi
  else
    if [[ "${task_present}" == true ]]; then
      delete_task
      idle_since="${now}"
    fi

    if [[ "${saw_active}" == true ]]; then
      grace_seconds="${IDLE_GRACE_SECONDS}"
    else
      grace_seconds="${STARTUP_GRACE_SECONDS}"
    fi

    if (( now - idle_since >= grace_seconds )); then
      echo "Paseo idle for ${grace_seconds}s; stopping Sprite service."
      curl \
        --silent \
        --show-error \
        --unix-socket "${SPRITE_SOCKET}" \
        --request POST \
        "${SERVICE_STOP_URL}" >/dev/null &
      wait $! 2>/dev/null || true
      exit 0
    fi
  fi

  sleep "${POLL_SECONDS}"
done

wait "${daemon_pid}"
